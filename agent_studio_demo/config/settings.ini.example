# 本地配置模板
#
#   Copy-Item config\settings.ini.example config\settings.ini
#
# 然后把真实密钥填进 settings.ini。
# settings.ini 已在 .gitignore 里，**永远不会被提交**；本文件（.example）才是入库的模板。
#
# 优先级：进程环境变量 > config/settings.ini > .env（旧方式） > 代码默认值
# 只"补齐"不"覆盖"，所以临时覆盖可以这样：
#   $env:DEEPSEEK_API_KEY = "sk-..."
#   python -m agent.demo --message "在吗"

[model]
# 不填 api_key 就自动使用离线 heuristic：不联网、不花钱、回复是模板
api_key =
base_url = https://api.deepseek.com
model = deepseek-chat
# 临时故障（5xx / 超时 / 连接失败）重试次数；4xx 一律不重试
max_retries = 2
# 指数退避基数（秒）：0.5 → 1 → 2
retry_base_delay = 0.5

# 语义检索用的 embedding（DeepSeek 没有 embeddings 接口，需要另一家服务）
embedding_base_url =
embedding_api_key =
embedding_model =

[server]
# auto 有 key 用远程模型，没 key 用离线
provider = auto
# auto 有 langgraph 用官方引擎，否则用自研同构实现
graph_engine = auto
# auto 有 fastapi 用它，否则用标准库适配器
adapter = auto
# auto 有 granian 用它，其次 uvicorn，最后 stdlib
server_backend = auto
host = 127.0.0.1
port = 8000
# 观测事件的 UDP 端口，0 = 关闭
udp_port = 0
checkpoint_path = runtime/api.sqlite3
# 会话空闲多久清理（秒；0 = 不按时间清理）
session_ttl = 3600
# 最多保留多少个会话（0 = 不限制）
session_max = 64
# 本地 trace 落盘路径，留空则不写
trace_jsonl =

[features]
# 1 = token 级流式（正文先于 critique）
stream = 0
# 1 = 导入时用模型补人设语义字段（称呼/关系/口头禅/禁用词）
persona_llm = 0
# 1 = 检索时用模型做查询扩写
expand_query = 0
# 允许导入的聊天文件根目录，留空 = 项目根
chat_root =

[search]
# 证据分数阈值（低于它就当没召回）；换检索后端后要重标
min_evidence_score = 0.12
