# 【已不推荐】旧的环境变量模板
#
# 现在请用配置文件：复制 config/settings.ini.example 为 config/settings.ini
#   Copy-Item config\settings.ini.example config\settings.ini
#
# 本文件仍保留，是因为 .env 依然被支持（优先级低于 settings.ini）。
# .env 同样在 .gitignore 里，不要提交。

# 回复模型（远程，OpenAI 兼容）；不配 key 就自动用离线 heuristic
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 预检：python -m llm_client.check  （0=通 / 1=失败 / 2=没配 key）

# token 级流式（1=开启）。开启后事件顺序变成：正文先于 critique
STREAM=0

# 语义 embedding 后端（Day10 的 HttpEmbedder / ab_test --embedder http 用）
# 任意 OpenAI 兼容的 /embeddings 接口，例如 https://api.openai.com/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 传输层（Day14）
PROVIDER=auto
CHECKPOINT_PATH=runtime/api.sqlite3
HOST=127.0.0.1
PORT=8000

# 编排引擎：auto（有 langgraph 用官方实现）/ langgraph / builtin（零依赖）
GRAPH_ENGINE=auto

# 人设卡语义字段（称呼/关系/口头禅/禁用词）：1 = 导入时用模型抽取一次
PERSONA_LLM=0

# 适配器：auto 有 fastapi+uvicorn 就用它，否则退回标准库实现
ADAPTER=auto
# 服务器：auto = granian > uvicorn > stdlib（按实测吞吐，选已安装的）
SERVER=auto

# UDP 观测事件的目标端口（0 = 关闭）；对应接收端 python -m transport.udp_listen
UDP_PORT=0
# 同时把观测事件落到本地 JSONL（开发期用）
TRACE_JSONL=
